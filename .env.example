# Copy this file to .env for local development and enter your own key.
# Never commit .env or paste the key into public code/chat.
GEMINI_API_KEY=PASTE_YOUR_PRIVATE_KEY_HERE
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
MIN_SIMILARITY_SCORE=0.35
FRONTEND_ORIGINS=http://localhost:5175,http://127.0.0.1:5175,http://localhost:5173,http://127.0.0.1:5173
